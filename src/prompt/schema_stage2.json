{
  "type": "object",
  "required": ["feedback_items", "student_feedback", "reviewer_notes"],
  "properties": {
    "feedback_items": {
      "type": "array",
      "description": "Structured feedback items selecting at most the 6 most important high-confidence problems mapped in Stage 1.",
      "items": {
        "type": "object",
        "required": [
          "criterion_id",
          "criterion_name",
          "severity",
          "confidence",
          "problem",
          "consequence",
          "how_to_fix",
          "evidence_refs"
        ],
        "properties": {
          "criterion_id": { "type": "string" },
          "criterion_name": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["minor", "moderate", "major", "blocking"]
          },
          "confidence": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "problem": {
            "type": "string",
            "description": "In Portuguese."
          },
          "consequence": {
            "type": "string",
            "description": "In Portuguese."
          },
          "how_to_fix": {
            "type": "string",
            "description": "In Portuguese."
          },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "student_feedback": {
      "type": "string",
      "description": "Full text feedback formatted as concise GitHub-review lines for the student, in Portuguese."
    },
    "reviewer_notes": {
      "type": "object",
      "required": [
        "requires_human_review",
        "synthesis_rationale",
        "omitted_stage1_deductions",
        "low_confidence_items"
      ],
      "properties": {
        "requires_human_review": {
          "type": "boolean",
          "description": "True when the final feedback contains or omits items that need reviewer inspection."
        },
        "synthesis_rationale": {
          "type": "string",
          "description": "Brief explanation in Portuguese of why these feedback items were selected."
        },
        "omitted_stage1_deductions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Stage 1 deductions intentionally omitted from student feedback."
        },
        "low_confidence_items": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Low-confidence items that should be checked by a human reviewer."
        }
      }
    }
  }
}
